PORT=3000
DATABASE_PATH=./data/database.sqlite
UPLOAD_PATH=./data/uploads
BACKUP_PATH=./data/backups

# Optional bootstrap values for automated or legacy deployments. Leave these
# commented to use the first-run setup page.
# ORIGIN=http://localhost:3000
# AUTH_MODE=none
# AUTH_PASSWORD_HASH=
AUTH_SESSION_TTL_DAYS=30
AUTH_PROXY_HEADER=Remote-User
AUTH_PROXY_TRUSTED_CIDRS=

TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=© OpenStreetMap contributors
TILE_MAX_ZOOM=19
TILE_PROXY_ENABLED=true
TILE_CACHE_PATH=./data/tile-cache
TILE_CACHE_MAX_MB=512

GEOCODING_ENABLED=true
GEOCODING_PROVIDER=nominatim
GEOCODING_URL=https://nominatim.openstreetmap.org
GEOCODING_API_KEY=
GEOCODING_AUTOCOMPLETE=false
GEOCODING_CACHE_TTL_DAYS=30

UPLOAD_MAX_FILE_SIZE_MB=15
UPLOAD_MAX_FILES_PER_PLACE=10
IMPORT_MAX_SIZE_MB=25
RESTORE_MAX_SIZE_MB=2048
